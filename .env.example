# ===================================================
# IOT SORTING SYSTEM - ENVIRONMENT TEMPLATE (.env.example)
# Sao chép file này thành .env và điền thông tin thực tế
# ===================================================

# 1. DATABASE CONFIGURATION (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/iot_sorting_db

# 2. JWT SECURITY
JWT_SECRET_KEY=change_this_to_your_secure_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. BACKEND & API CONFIGURATION
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# 4. MQTT BROKER CONFIGURATION
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_SERVO_TOPIC=factory/servo/control
MQTT_LOGS_TOPIC=factory/sorting/logs

# 5. CAMERA & EDGE DETECTION
CAMERA_ID=0
CONFIDENCE_THRESHOLD=0.85
