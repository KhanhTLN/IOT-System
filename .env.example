# ===================================================
# IOT SORTING SYSTEM - ENVIRONMENT TEMPLATE (.env.example)
# Sao chép file này thành .env và điền thông tin thực tế
# ===================================================

# 1. DATABASE CONFIGURATION (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/iot_sorting_db

# 2. JWT SECURITY
JWT_SECRET_KEY=change_this_to_your_secure_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. BACKEND & API CONFIGURATION
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# 4. MQTT BROKER CONFIGURATION (Mosquitto Local / LAN)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_SERVO_TOPIC=factory/servo/control
MQTT_LOGS_TOPIC=factory/sorting/logs

# 5. CAMERA & EDGE DETECTION
# 0: Camera mặc định / Laptop tích hợp, 1: Webcam ngoài cắm cổng USB
CAMERA_ID=1
CONFIDENCE_THRESHOLD=0.85

# 6. DEEP LEARNING (YOLOv8 ONNX) & TRACKING
# DETECTOR_BACKEND: "YOLO" (tự động lùi về HSV nếu chưa có model) hoặc "HSV"
DETECTOR_BACKEND=YOLO
YOLO_MODEL_PATH=models/best.onnx
# Khi mới test dataset nhỏ (~30 ảnh) nên đặt 0.60 - 0.65; khi train đầy đủ nâng lên 0.85
YOLO_CONF_THRESHOLD=0.65
YOLO_IOU_THRESHOLD=0.45
